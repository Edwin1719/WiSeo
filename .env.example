# =============================================================
# SEO Agent — Configuracion
# Copia este archivo a .env y completa los valores
# =============================================================

# --- DeepSeek (orquestador LLM) ---
# Obten tu key en: https://platform.deepseek.com/api_keys
# Modelos disponibles:
#   deepseek-v4-flash  → rapido, barato, ideal para tool calling ($0.27/M tokens)
#   deepseek-v4-pro    → razonamiento profundo, analisis complejos ($0.55/M tokens)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
# Si wigolo corre localmente (por defecto), no necesita configuracion.
# Si usas el endpoint REST/NPX, especifica:
# WIGOLO_MCP_COMMAND=npx
# WIGOLO_MCP_ARGS=-y wigolo

# --- OpenSEO MCP ---
# URL del servidor MCP (default Docker self-hosted)
OPENSEO_MCP_URL=http://localhost:3001/mcp

# --- DataForSEO (datos SEO: keywords, backlinks, SERPs) ---
# 1. Crea cuenta en: https://app.dataforseo.com/api-access?aff=255379
# 2. Ve a API Access y copia tu "API Password" + el email de tu cuenta
# 3. Combínalos en formato email:password (SIN codificar a Base64)
#    OpenSEO ya se encarga de codificarlo internamente.
# 4. Esta key se pasa al Docker de OpenSEO al arrancar — no la usa el agente directamente.
#    Importante: NO uses el "Base64 Format" de DataForSEO, usa el formato CRUDO.
DATAFORSEO_API_KEY=tu-email@ejemplo.com:tu-api-password
